# Supabase project credentials — these are safe for the browser bundle
# (Supabase's URL + anon/public key are designed to be public; access is
# enforced server-side via Row Level Security).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry (frontend). A DSN is a public identifier, not a secret — like the
# Supabase anon key above, it's meant to ship inside the browser bundle.
# Leave VITE_SENTRY_DSN unset locally to run with Sentry disabled (see
# src/lib/sentry.ts, which no-ops without it).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Set by CI to the git SHA at build time (see .github/workflows/) — leave
# unset locally.
VITE_SENTRY_RELEASE=

# NEVER put the Supabase service-role key, the Sentry auth token used to
# upload source maps, or any other third-party secret, into this file or
# into any VITE_-prefixed variable. Anything prefixed VITE_ is inlined into
# the client-side JavaScript bundle and is readable by anyone who loads the
# app.
